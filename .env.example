# Backend API base URL (sin slash final). El cliente le agrega /auth/login, /students, etc.
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# URL del servidor de WebSockets (Socket.IO) para mensajería en tiempo real.
# Es el mismo host que NEXT_PUBLIC_API_URL pero SIN el sufijo /v1 (el gateway
# corre en el mismo server Nest, en la raíz). En Vercel hay que setearla
# explícitamente: si no está definida, el cliente cae a http://localhost:3001
# y el socket falla en producción (mensajería en tiempo real rota).
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Tenant activo (debe existir en src/config/tenants/<id>.ts y en public/tenants/<id>/)
NEXT_PUBLIC_TENANT=default

# OAuth 2.0 Client ID (Web application) creado en Google Cloud Console.
# Solo el client_id, NO el client_secret. Necesario para "Sign in with Google".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
